# Application port and debug mode.
APP_NAME=Pokget
APP_PORT=18066
DEBUG=false
LOG_FORMAT=text
SECURE_COOKIES=false
RATE_LIMIT=20
BURST_LIMIT=50
WRITE_TIMEOUT=120
SCAN_RATE_LIMIT=5
SCAN_BURST_LIMIT=10

# Secret key for CSRF tokens and session protection. Required.
SESSION_KEY=

# Trusted reverse proxy configuration.
TRUST_PROXY=false
TRUSTED_PROXIES=
TRUST_CLOUDFLARE=false

# Database credentials. Required.
DB_USER=pokget_user
DB_PASSWORD=
DB_NAME=pokget_db

# Native-only database settings; Compose supplies its internal host/port/SSL mode.
DB_HOST=localhost
DB_PORT=5433
DB_SSLMODE=disable
MIGRATIONS_PATH=migrations

# Optional mail delivery; supply credentials from your mail provider.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@pokget.com

# Claude Vision Card Detector (Anthropic Claude API)
# Primary card detection engine replacing legacy OCR, pHash, and Ollama.
# Recommended model: claude-sonnet-5-5 (fast, high accuracy, lowest cost).
# Alternative model: claude-opus-5-5.
CLAUDE_ENABLED=true
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_BASE_URL=https://api.anthropic.com/v1/messages
CLAUDE_TIMEOUT_SECONDS=30
CLAUDE_PROMPT_CACHING=true

# Server-side detection. Card recognition runs only on the server; the phone
# uploads the cropped photo and never runs OCR.
SCAN_TIMEOUT_SECONDS=75
SCAN_MAX_CONCURRENT=3
SCAN_PHASH_HIGH_CONF=5
SCAN_PHASH_POTENTIAL=10

# Optional remote OpenAI-compatible provider for card-name suggestions.
LLM_BASE_URL=
LLM_MODEL=
LLM_API=
LLM_MAX_TOKENS=1024

CATALOG_ENABLED=true
LEGACY_METADATA_SYNC_ENABLED=false
CATALOG_LANGUAGE=en,de,ja,fr,zh-cn,zh-tw,ko
CATALOG_SYNC_INTERVAL_MINUTES=360
CATALOG_BATCH_SIZE=500
CATALOG_REQUEST_DELAY_MS=100
# 0 means unlimited source pages.
CATALOG_WEISS_MAX_PAGES=0
CATALOG_IMAGES_ENABLED=true
CATALOG_IMAGE_STORE=/app/data/catalog-images
CATALOG_IMAGE_BATCH_SIZE=8
CATALOG_IMAGE_CONCURRENCY=4
CATALOG_IMAGE_POLL_INTERVAL_MS=5000
PRICE_SYNC_INTERVAL_MINUTES=60
# Derives a EUR price from the USD market price with the daily ECB rate and flags
# the row in cards.price_eur_estimated.
PRICE_EUR_FALLBACK=true
# Per-card price backfill for Pokemon catalog cards without a price (via TCGdex):
# cards per hourly pass (0 disables it) and its own request rate.
PRICE_BACKFILL_BATCH=25000
PRICE_BACKFILL_REQUESTS_PER_SECOND=6
# Hourly refresh budget for cards a user tracks (portfolio, wantlist, alerts). The
# budget is split evenly across the collectors that track cards.
PRICE_TRACKED_LIMIT=100
# Refresh cadence of the free bulk exports (Scryfall, YGOPRODeck, TCGCSV).
PRICE_BULK_INTERVAL_HOURS=24
# Scanned card photos are copied here by POST /portfolio/add.
PORTFOLIO_PHOTO_STORE=/app/data/card-photos
METADATA_TARGETS=pokemon:en
WORKER_REQUESTS_PER_SECOND=0.5
WORKER_REQUEST_BURST=1
WORKER_RETRY_ATTEMPTS=3
WORKER_RETRY_BASE_DELAY_MS=1000
WORKER_CIRCUIT_FAILURES=3
WORKER_CIRCUIT_COOLDOWN_SECONDS=300
WORKER_MAX_PRICE_RATIO=5
PRICE_HISTORY_RETENTION_DAYS=730
WORKER_FAILURE_PATH=/app/data/cache/worker-failures.jsonl
