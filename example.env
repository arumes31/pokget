# Copy to .env for Docker Compose; never commit the populated .env.
# REQUIRED: fill DB_PASSWORD and SESSION_KEY before starting.
# A blank DB_PASSWORD uses Compose's existing pokget_pass fallback; it is not safe.
# Generate a fresh session key with: openssl rand -hex 32
# Native Go does NOT read .env automatically. See CONFIGURATION.md.

APP_NAME=Pokget
APP_PORT=18066
# Enables per-pass server OCR diagnostics; never logs raw OCR text or images.
DEBUG=false
LOG_FORMAT=text
# Keep true behind HTTPS. Set false ONLY for trusted local HTTP development.
SECURE_COOKIES=true
WRITE_TIMEOUT=120
TRUST_PROXY=false
TRUST_CLOUDFLARE=false
# Used only by docker-compose.ghcr.yml; select a published tag/digest when needed.
POKGET_IMAGE=ghcr.io/arumes31/pokget:latest

DB_USER=pokget_user
DB_PASSWORD=
DB_NAME=pokget_db
SESSION_KEY=
# Native-only database settings; Compose supplies its internal host/port/SSL mode.
DB_HOST=localhost
DB_PORT=5433
DB_SSLMODE=disable
MIGRATIONS_PATH=migrations

# Optional mail delivery; supply credentials from your mail provider.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@pokget.com

# Server OCR/detection. Device OCR has its own fixed 20-second browser budget.
SCAN_TIMEOUT_SECONDS=75
SCAN_OCR_POOL_SIZE=3
SCAN_PHASH_HIGH_CONF=5
SCAN_PHASH_POTENTIAL=10
OMP_THREAD_LIMIT=1

# Optional remote OpenAI-compatible primary provider. Empty URL means local only.
LLM_BASE_URL=
LLM_MODEL=moonshotai/kimi-k3
LLM_API=
LLM_MAX_TOKENS=1024

# Local TEXT selector for already-read OCR, not an image OCR model.
# For a native app use http://localhost:11434 instead of the Compose service name.
OLLAMA_HOST=pokget_ollama
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_TEMPERATURE=0
OLLAMA_SEED=42
OLLAMA_NUM_PREDICT=128
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_THREAD=4
OLLAMA_MAX_CANDIDATES=20
OLLAMA_MIN_EVIDENCE=180
OLLAMA_MIN_CONFIDENCE=0.55
# Ollama server settings (not application settings).
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_KEEP_ALIVE=5m

# Optional IMAGE OCR fallback. Pull qwen3.5:2b before enabling. Always review.
SCAN_VISION_OCR_ENABLED=false
SCAN_VISION_OCR_URL=http://pokget_ollama:11434
SCAN_VISION_OCR_MODEL=qwen3.5:2b
# Valid range 1..45; remaining scan time can shorten this further.
SCAN_VISION_OCR_TIMEOUT_SECONDS=45
SCAN_VISION_OCR_THREADS=4

CATALOG_ENABLED=true
LEGACY_METADATA_SYNC_ENABLED=false
CATALOG_LANGUAGE=en,de,ja,fr,zh-cn,zh-tw,ko
CATALOG_SYNC_INTERVAL_MINUTES=360
CATALOG_BATCH_SIZE=500
CATALOG_REQUEST_DELAY_MS=100
# 0 means unlimited source pages.
CATALOG_WEISS_MAX_PAGES=0
CATALOG_IMAGES_ENABLED=true
CATALOG_IMAGE_BATCH_SIZE=8
CATALOG_IMAGE_POLL_INTERVAL_MS=5000
# Native paths; Compose fixes these to its writable mounted directories.
CATALOG_IMAGE_STORE=data/catalog-images
WORKER_FAILURE_PATH=data/worker-failures.jsonl

PRICE_SYNC_INTERVAL_MINUTES=60
METADATA_TARGETS=pokemon:en
WORKER_REQUESTS_PER_SECOND=0.5
WORKER_REQUEST_BURST=1
WORKER_RETRY_ATTEMPTS=3
WORKER_RETRY_BASE_DELAY_MS=1000
WORKER_CIRCUIT_FAILURES=3
WORKER_CIRCUIT_COOLDOWN_SECONDS=300
WORKER_MAX_PRICE_RATIO=5
PRICE_HISTORY_RETENTION_DAYS=730
